NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SITE_URL=

# Meta Conversions API (server-side Purchase delivery from the Razorpay webhook/verify-payment
# routes only — src/lib/meta-capi.ts). The Pixel/Dataset ID itself (1134116805951491) is not a
# secret and stays hardcoded in src/app/layout.tsx and src/lib/meta-capi.ts; do not add a
# NEXT_PUBLIC_ variant of the access token, it must never reach the browser.
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=

# Server-only. Bypasses Row Level Security — used only by the Razorpay verify/webhook routes.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay. Use test-mode keys (rzp_test_...) until launch, then switch to live keys (rzp_live_...)
# in Vercel's production environment only. Never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Transactional email (order/payment/contact-form notifications).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Server-only. Used exclusively by src/app/api/pets/[publicId]/share-location/route.ts to email
# the pet owner a Google Maps link when a finder shares their location from the public QR profile.
# Must be set in every environment that needs this feature working (production included) — there
# is no fallback to RESEND_API_KEY if this is missing, the route fails closed instead.
RESEND_API_KEY_FOR_MAP=
